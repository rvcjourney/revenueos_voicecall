# MOTMVoice Backend — Environment Variables
# Copy to .env and fill in all CHANGE_ME values before running.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=MOTMVoice
APP_VERSION=1.0.0
ENVIRONMENT=development         # development | staging | production
DEBUG=false
DOCS_ENABLED=true               # set false in production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-domain.example.com   # used to build Vobiz webhook callback URLs

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_at_least_32_chars_for_jwt_signing
AGENT_WEBHOOK_SECRET=CHANGE_ME_at_least_32_chars_for_hmac_signing
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_generate_a_real_fernet_key_see_comment_above
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Supabase Cloud PostgreSQL) ───────────────────────────────────────
# Get these from your Supabase project: Settings → Database → Connection string
#
# Option A — Direct connection (recommended; SQLAlchemy manages its own pool):
#   DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Option B — Session-mode pooler (Supabase PgBouncer, port 5432):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Option C — Transaction-mode pooler (Supabase PgBouncer, port 6543):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Also set: DB_USE_PGBOUNCER=true
#
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
DB_SSL_REQUIRED=true          # Supabase requires SSL — keep true
DB_USE_PGBOUNCER=false        # Set true only for Option C (transaction pooler, port 6543)

# ── Supabase project keys ──────────────────────────────────────────────────────
# Settings → API in the Supabase dashboard
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME   # keep secret — never expose in frontend
# Set to false ONLY temporarily (e.g. Supabase email sending is down/rate-limited)
# to let /login through without a verified email. Flip back to true ASAP.
REQUIRE_EMAIL_VERIFICATION=true

# ── Redis ──────────────────────────────────────────────────────────────────────
# In docker-compose: host is "redis". Locally: "localhost".
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=["http://localhost:3000","https://app.motmvoice.com"]

# ── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME

# ── SIP / Vobiz ───────────────────────────────────────────────────────────────
DEFAULT_SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxxx
DEFAULT_SIP_CALLER_ID=+91XXXXXXXXXX
VOBIZ_SIP_DOMAIN=xxxxxxxx.sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_username
VOBIZ_PASSWORD=CHANGE_ME

# Vobiz API credentials (for recording URL fetch after each call)
# Find these in your Vobiz console → Dashboard → API credentials
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token

# ── Deepgram STT ──────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=CHANGE_ME

# ── ElevenLabs TTS ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=CHANGE_ME
ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b

# ── OpenAI (Prime Calling) ────────────────────────────────────────────────────
# Optional. Researches each Prime contact (website + live web search) and
# writes their call brief. Leave blank to use Groq instead (no web search).
OPENAI_API_KEY=
# gpt-5.6-luna = cheapest; gpt-5.6-terra / gpt-5.6-sol / gpt-6-astra = stronger, pricier
PRIME_OPENAI_MODEL=gpt-5.6-luna
PRIME_REASONING_EFFORT=high
# auto = web search only when the contact's website couldn't be read; always; never
PRIME_WEB_SEARCH=auto

# ── Razorpay ───────────────────────────────────────────────────────────────────
# Dashboard -> Settings -> API Keys (use Test Mode keys until you go live)
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Dashboard -> Settings -> Webhooks -> the webhook pointed at
# https://<PUBLIC_BASE_URL>/webhooks/razorpay -- the secret is the string YOU
# typed in when creating that webhook, not the webhook URL itself.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# false = credits and payments are off for every organization: nobody is
# blocked for credits or an unpaid subscription, and new sign-ups start active.
BILLING_ENABLED=true

# ── RevenueOS Brain integration (docs/revenueos-integration.md) ───────────────
# Secret Brain sends in the X-RevenueOS-Key header, at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Blank = every RevenueOS route answers 503.
REVENUEOS_API_KEY=
# Lets the key create accounts, phone numbers, agents and campaigns.
REVENUEOS_LAUNCH_ENABLED=false
# Lets a launch start calling real people with nobody reviewing it.
REVENUEOS_AUTO_START_ENABLED=false
REVENUEOS_MAX_CONTACTS=500

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=minio           # minio | s3

# MinIO (default — self-hosted via docker-compose)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_in_production
MINIO_SECURE=false

# AWS S3 (set STORAGE_BACKEND=s3 to use these instead of MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bucket names (created automatically on startup)
BUCKET_RECORDINGS=motm-recordings
BUCKET_EXPORTS=motm-exports
BUCKET_TRANSCRIPTS=motm-transcripts
BUCKET_BACKUPS=motm-backups
BUCKET_VOICE_CONSENT=motm-voice-consent
BUCKET_INVOICES=motm-invoices
EXPORT_URL_EXPIRY_SECONDS=600

# Offsite database backups — a daily pg_dump always uploads to BUCKET_BACKUPS
# above, but when STORAGE_BACKEND=minio that bucket lives on this same VPS's
# disk, so it doesn't protect against losing the VPS itself. Set these to a
# genuinely separate S3-compatible bucket (AWS S3, Backblaze B2, Cloudflare
# R2, Wasabi all work) for real disaster recovery. Leave blank to disable —
# the local backup still runs either way. See app/workers/tasks/backup.py.
OFFSITE_BACKUP_ENDPOINT_URL=     # e.g. https://s3.us-west-004.backblazeb2.com
OFFSITE_BACKUP_ACCESS_KEY=
OFFSITE_BACKUP_SECRET_KEY=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_REGION=us-east-1
BACKUP_RETENTION_DAYS=14

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=                     # leave empty to disable
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Internal ──────────────────────────────────────────────────────────────────
BACKEND_INTERNAL_URL=http://api:8000
AGENT_TEMPLATE_CACHE_TTL=60
