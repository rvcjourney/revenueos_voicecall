# MOTMVoice Voice Agent — Environment Variables
# Copy this file to .env and fill in all CHANGE_ME values before running.

# ── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME

# ── Sarvam AI (STT + LLM + TTS for every call) ────────────────────────────────
SARVAM_API_KEY=CHANGE_ME
# Optional: ElevenLabs voices for regional languages (set per language in the platform admin)
ELEVENLABS_API_KEY=

# ── Agent Behavior (optional — overrides config.py defaults) ──────────────────
# AGENT_SYSTEM_PROMPT=

# ── Backend reporting ─────────────────────────────────────────────────────────
# Use http://localhost:8000 when running locally.
# Use http://api:8000 only inside Docker Compose (where "api" is the backend service name).
BACKEND_INTERNAL_URL=http://localhost:8000
# Must match the backend's AGENT_WEBHOOK_SECRET (signs post-call reports and tool calls).
AGENT_WEBHOOK_SECRET=CHANGE_ME

# ── Observability (all optional) ────────────────────────────────────────────
# "development" renders logs as colored console text instead of JSON.
# ENVIRONMENT=development
# Sentry error tracking — leave unset to disable (no-op).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
