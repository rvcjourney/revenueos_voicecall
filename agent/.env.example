# MOTMVoice Voice Agent — Environment Variables
# Copy this file to .env and fill in all CHANGE_ME values before running.

# ── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME

# ── Deepgram STT ──────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=CHANGE_ME

# ── ElevenLabs TTS ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=CHANGE_ME
ELEVENLABS_VOICE_ID=6h2Hja4LgQR8wIIv3XXW
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Chatterbox TTS (self-hosted on a GPU pod, e.g. RunPod) — optional, testing only ──
# CHATTERBOX_BASE_URL=https://xxxxx-8004.proxy.runpod.net
# CHATTERBOX_VOICE_ID=default
# CHATTERBOX_LANGUAGE=hi

# ── Sarvam AI TTS (Bulbul v3 — hosted API, native Hindi voices) ─────────────────
SARVAM_API_KEY=CHANGE_ME
# SARVAM_MODEL=bulbul:v3
# SARVAM_VOICE_ID=shubh

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# ── SIP / Vobiz ───────────────────────────────────────────────────────────────
SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxxx
SIP_TRUNK_NUMBER=+91XXXXXXXXXX
OUTBOUND_SIP_URI=your_number@sip.vobiz.ai
VOBIZ_SIP_DOMAIN=xxxxxxxx.sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_username
VOBIZ_PASSWORD=CHANGE_ME

# ── Agent Behavior (optional — overrides config.py defaults) ──────────────────
# AGENT_WELCOME_MESSAGE=Namaste sir! Main Aniket bol raha hoon...
# AGENT_SYSTEM_PROMPT=

# ── Backend reporting ─────────────────────────────────────────────────────────
# Use http://localhost:8000 when running locally.
# Use http://api:8000 only inside Docker Compose (where "api" is the backend service name).
BACKEND_INTERNAL_URL=http://localhost:8000
